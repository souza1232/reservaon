# ============================================================
# ReservaOn — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores.
# ============================================================

# --- Banco de dados (obrigatório) --------------------------------------
# Local com Docker (ver docker-compose.yml): docker compose up -d
DATABASE_URL="postgresql://agendapro:agendapro@localhost:5432/agendapro?schema=public"

# --- Autenticação (obrigatório) -----------------------------------------
# Gere um valor aleatório com: openssl rand -base64 32
AUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio"
# URL pública da aplicação (usada pelo Auth.js para gerar callbacks)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- E-mail (opcional) ---------------------------------------------------
# Se não configurado, o sistema funciona normalmente e apenas registra
# a notificação como "SKIPPED" em vez de enviar e-mail de verdade.
# Compatível com qualquer provedor SMTP (Resend, SendGrid, Mailgun, etc.)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="ReservaOn <contato@seudominio.com>"

# --- WhatsApp Business API (opcional) -------------------------------------
# Sem estas variáveis, o sistema continua funcionando normalmente: cada envio
# fica registrado como "SKIPPED" em vez de mandar de verdade (nada quebra).
#
# Como obter (business.facebook.com):
#   1. Criar um app em developers.facebook.com > "Meus Apps" > "Criar app"
#      (tipo "Business"), e adicionar o produto "WhatsApp".
#   2. Em WhatsApp > Configuração da API, registrar um número de telefone
#      dedicado (não pode ser um número já usado no WhatsApp normal).
#   3. Verificar a empresa em business.facebook.com (Configurações do
#      negócio > Central de segurança > Verificação empresarial) — pode
#      levar de 1 a 3 dias.
#   4. Gerar um token com permissão whatsapp_business_messaging (via Graph
#      API Explorer, com o app inscrito na WABA — ver subscribed_apps) e
#      trocar por um long-lived token (~60 dias). FACEBOOK_APP_ID/SECRET
#      abaixo são usados pelo cron whatsapp-token-refresh pra renovar esse
#      token automaticamente antes de expirar, sem precisar gerar de novo.
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# Webhook inbound — botões "Confirmar presença"/"Cancelar" no lembrete (ver
# src/app/api/webhooks/whatsapp/route.ts). Gere um valor aleatório e
# cadastre o mesmo no Painel do desenvolvedor → WhatsApp → Webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Nome do template com botões, preenchido só depois de aprovado na Meta.
WHATSAPP_TEMPLATE_REMINDER_INTERACTIVE=""
# Template da oferta de vaga da lista de espera (botões "Quero o
# horário!"/"Não, obrigado") — ver src/lib/appointment-mutations.ts.
WHATSAPP_TEMPLATE_WAITLIST_OFFER=""

# Nome de cada template aprovado no Meta Business Manager (WhatsApp Manager >
# Templates de mensagem > Criar template, categoria "Utilidade"). O cliente
# agenda pelo site, não pelo WhatsApp, então SEMPRE precisa de template
# aprovado — não dá para mandar texto livre. Cada template abaixo é um corpo
# com 4 variáveis, nesta ordem: nome do cliente, nome da empresa, data
# (dd/mm/aaaa), horário (HH:mm). Sem o nome do template configurado, aquele
# tipo de envio simplesmente não é tentado.
#
# Texto sugerido para submeter (pode ajustar a redação, mas mantenha as 4
# variáveis {{1}} a {{4}} nesta ordem):
#   Confirmação: "Olá {{1}}! Seu agendamento na {{2}} foi confirmado para
#     {{3}} às {{4}}."
#   Cancelamento: "Olá {{1}}, seu agendamento na {{2}} do dia {{3}} às {{4}}
#     foi cancelado."
#   Remarcação: "Olá {{1}}, seu agendamento na {{2}} foi remarcado para
#     {{3}} às {{4}}."
#   Lembrete: "Olá {{1}}, lembrete do seu horário na {{2}} hoje, dia {{3}},
#     às {{4}}. Até já!"
WHATSAPP_TEMPLATE_CONFIRMATION=""
WHATSAPP_TEMPLATE_CANCELLATION=""
WHATSAPP_TEMPLATE_RESCHEDULE=""
WHATSAPP_TEMPLATE_REMINDER=""
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"

# Pedido de avaliação no Google, disparado sozinho quando o cron diário
# auto-conclui um agendamento cujo horário já passou (ver
# src/lib/appointment-mutations.ts > autoCompleteDueAppointments). Só é
# enviado se a empresa tiver cadastrado o link de avaliação em Configurações
# (Company.googleReviewUrl) — sem link, nada é enviado, mesmo com este
# template configurado. Corpo com 3 variáveis (diferente do padrão de 4 dos
# outros): nome do cliente, nome da empresa, link de avaliação.
#
# Texto sugerido para submeter:
#   "Olá {{1}}! Obrigado por escolher a {{2}}. Poderia deixar uma avaliação
#     rápida pra gente? {{3}}"
WHATSAPP_TEMPLATE_REVIEW_REQUEST=""

# Quantas horas à frente contar como "lembrete devido" (ver
# src/app/api/cron/whatsapp-reminders e vercel.json). No plano Hobby da
# Vercel o cron roda só 1x/dia (09h em America/Sao_Paulo), então o padrão é
# 24h — na prática vira "lembrete pela manhã dos agendamentos do dia". Num
# plano Pro, dá pra rodar o cron mais vezes e reduzir esse valor (ex: "2"
# para lembrete 2h antes de cada horário).
WHATSAPP_REMINDER_LEAD_HOURS="24"

# Protege o endpoint de cron contra chamadas externas não autorizadas —
# gere com: openssl rand -base64 32. Sem isso definido, o endpoint aceita
# qualquer chamada (ok para começar, mas defina em produção).
CRON_SECRET=""

# --- Pagamentos via Stripe (opcional, mas já integrado no código) ---------
# O produto/preço do plano "Profissional" já foram criados no Stripe em modo
# TESTE (ver prisma/seed.ts). Para o checkout e o webhook funcionarem, cole
# aqui os valores da SUA conta Stripe (Developers → API keys / → Webhooks):
#   STRIPE_SECRET_KEY        -> Developers > API keys > Secret key
#   STRIPE_PUBLISHABLE_KEY   -> Developers > API keys > Publishable key
#   STRIPE_WEBHOOK_SECRET    -> Developers > Webhooks > (endpoint) > Signing secret
# Sem essas chaves, o sistema continua funcionando normalmente — os botões
# de assinatura mostram um aviso em vez de quebrar a página.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""

# --- Pagamentos via Asaas (PIX recorrente, opcional) -----------------------
# Alternativa ao Stripe pra empresas que preferem PIX. ASAAS_API_KEY em
# Configurações > Integrações > Chave de API (sandbox começa com
# $aact_hmlg_, produção com $aact_prod_). ASAAS_ENV é "sandbox" ou
# "production". ASAAS_WEBHOOK_TOKEN é um valor aleatório seu, cadastrado
# igual em Configurações > Integrações > Webhooks.
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"
ASAAS_WEBHOOK_TOKEN=""

# --- Sincronização com Google Agenda (opcional) ----------------------------
# Cada profissional conecta a própria conta em /profissional/configuracoes.
# Sem estas variáveis, o recurso fica invisível/desligado — nada quebra.
#
# Como obter (console.cloud.google.com):
#   1. Criar um projeto (ou usar um existente).
#   2. "APIs e serviços" > "Biblioteca" > ativar "Google Calendar API".
#   3. "APIs e serviços" > "Tela de consentimento OAuth" > configurar (tipo
#      "Externo" serve; não precisa de verificação do Google pra uso próprio/
#      poucos usuários, só aparece um aviso "app não verificado" no login).
#   4. "Credenciais" > "Criar credenciais" > "ID do cliente OAuth" > tipo
#      "Aplicativo da Web" > em "URIs de redirecionamento autorizados",
#      adicionar: SEU_DOMINIO/api/integrations/google-calendar/callback
#      (ex: https://agendapro-mu-olive.vercel.app/api/integrations/google-calendar/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Upload de imagens via Vercel Blob (opcional, já integrado no código) --
# Usado para logo da empresa e foto de profissionais/serviços.
# Como obter: no projeto na Vercel, aba "Storage" > "Create Database" >
# "Blob" > conectar ao projeto — o token é preenchido automaticamente lá.
# Sem essa variável, o sistema continua funcionando: os campos de imagem
# aceitam apenas URL de imagem já hospedada em outro lugar.
BLOB_READ_WRITE_TOKEN=""
